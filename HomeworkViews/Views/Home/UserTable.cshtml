@model UserViewModel

<table class="table table-striped table-bordered mt-3">
	<thead>
		<tr>
			<th>Имя</th>
			<th>Должность</th>
			<th>Возраст</th>
			<th>Зарплата</th>
		</tr>
	</thead>
	<tbody>
		@if (Model.Users.Any())
		{
			foreach (var user in Model.Users)
			{
				<tr>
					<td>@user.Name</td>
					<td>@user.Position</td>
					<td>@user.Age</td>
					<td>@user.Salary</td>
				</tr>
			}
		}
		else
		{
			<tr><td colspan="4" class="text-center">Нет данных</td></tr>
		}
	</tbody>
</table>