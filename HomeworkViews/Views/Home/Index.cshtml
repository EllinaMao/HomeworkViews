@model IndexViewModel

@{
    ViewData["Title"] = "Список пользователей";
}

<h1>Список пользователей</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input type="text" name="searchName" class="form-control" 
                   placeholder="Поиск по имени" value="@Model.SearchName" />
        </div>
        <div class="col-md-4">
            <input type="text" name="searchPosition" class="form-control" 
                   placeholder="Поиск по должности" value="@Model.SearchPosition" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Найти</button>
            <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
        </div>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Имя</th>
            <th>Должность</th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@Model.AgeSortParam"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchPosition="@Model.SearchPosition">
                    Возраст @Model.GetSortIcon("Age")
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@Model.SalarySortParam"
                   asp-route-searchName="@Model.SearchName"
                   asp-route-searchPosition="@Model.SearchPosition">
                    Зарплата @Model.GetSortIcon("Salary")
                </a>
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Users.Any())
        {
            foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Position</td>
                    <td>@user.Age</td>
                    <td>@user.Salary</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="4" class="text-center">Нет данных</td></tr>
        }
    </tbody>
</table>