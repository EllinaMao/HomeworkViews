@model UserViewModel

@{
	ViewData["Title"] = "Список пользователей";
}

<h1>Список пользователей</h1>

<form asp-action="Index" method="get" class="mb-3"
	  data-ajax="true"
	  data-ajax-method="get"
	  data-ajax-update="#usersTable"
	  data-ajax-mode="replace">

	<div class="row g-3">
		<div class="col-md-3">
			<input type="text" name="searchName" class="form-control"
				   placeholder="Имя" value="@Model.SearchName" />
		</div>

		<div class="col-md-3">
			<input type="text" name="searchPosition" class="form-control"
				   placeholder="Должность" value="@Model.SearchPosition" />
		</div>

		<div class="col-md-3">
			<select name="sortOrder" asp-for="SortOrder" class="form-select" onchange="$(this.form).submit();">
				<option value="">Сортировка по умолчанию (Имя)</option>
				<option value="Age">Возраст (по возрастанию)</option>
				<option value="age_desc">Возраст (по убыванию)</option>
				<option value="Salary">Зарплата (по возрастанию)</option>
				<option value="salary_desc">Зарплата (по убыванию)</option>
			</select>
		</div>

		<div class="col-md-3">
			<button type="submit" class="btn btn-primary">Найти</button>
			<a asp-action="Index" class="btn btn-secondary">Сбросить</a>
		</div>
	</div>
</form>

<div id="usersTable">
	<partial name="UserTable" model="Model" />
</div>